# Default: zero-cost local demo. No API key needed.
MOCK_MODE=true
PORT=3000

# Only used when MOCK_MODE=false
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Optional MCP server used by the real ADK agent.
# Example: http://localhost:8788/mcp
MCP_SERVER_URL=
